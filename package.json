{
  "name": "dinonest",
  "productName": "DinoNest",
  "version": "1.3.0",
  "description": "Brzi offline nesting program za laserski rez - DXF partovi po prioritetima na ploču",
  "main": "electron/main.js",
  "author": "Ivan Zubcic",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "samples": "node scripts/gen-samples.js",
    "icon": "node scripts/gen-icon.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "hr.dino.dinonest",
    "productName": "DinoNest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DinoNest",
      "artifactName": "DinoNest-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DinoNest-Portable-${version}-${arch}.${ext}"
    }
  }
}
